---
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { Picture } from 'astro:assets';

interface Props extends HTMLAttributes<'figure'> {
  image: ImageMetadata;
  altText: string;
  caption?: string;
  height?: string | number;
  width?: string | number;
  aspect?: 'auto' | 'video' | 'square';
  variant?: 'rounded' | 'plain' | 'avatar';
  layout?: 'default' | 'grid';
  border?: boolean;
  loading?: 'eager' | 'lazy';
}

const {
  image,
  altText,
  caption,
  height,
  width,
  aspect = 'auto',
  variant = 'plain',
  layout = 'default',
  border = false,
  loading = 'eager',
  ...attrs
} = Astro.props;
---

<figure
  class:list={[
    'w-fit overflow-clip  ml-auto  object-cover',
    variant === 'rounded' && 'rounded-md shadow-2xl',
    layout === 'grid' && 'grid grid-cols-2 rounded-xs',
    variant === 'avatar' && 'w-8 h-8 aspect-square rounded-full overflow-clip',
    border && 'border border-border p-1',
    aspect === 'square' && 'aspect-square',
    attrs.class,
  ]}
  {...attrs}
>
  <Picture
    src={image}
    quality={100}
    loading={loading}
    height={Number(height)}
    width={Number(width)}
    formats={['avif', 'webp']}
    class:list={[
      'object-cover h-full',
      variant !== 'avatar' &&
        aspect !== 'square' &&
        'max-h-[300px] md:max-h-[500px]',
      variant !== 'avatar' && 'rounded-xs',
    ]}
    alt={altText}
  />
  {
    caption && variant !== 'avatar' && (
      <figcaption
        class:list={[
          'leading-none flex font-mono text-sm items-center py-3',
          {
            'px-3 w-full text-center bg-white mx-auto justify-center':
              variant === 'rounded',
          },
        ]}
      >
        {caption}
      </figcaption>
    )
  }
</figure>
