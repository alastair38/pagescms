---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import FeaturedImage from './FeaturedImage.astro';
import SliderImage from './media/SliderImage.astro';

interface Props {
  images?: { image: ImageMetadata; alt?: string; caption?: string }[];
}

const { images } = Astro.props;

const lastOf = images && images.length - 1;
---

{
  images && images.length > 0 && (
    <div>
      <dialog class="w-full m-auto bg-base-500/80 p-3 md:p-6 backdrop:bg-base-500 md:backdrop:bg-base-500/80">
        <button
          autofocus
          class="px-2 cursor-pointer focus-visible:outline-emerald-300 py-1 md:mt-6 flex font-mono outline transition-colors duration-200 rounded-xs hover:outline-emerald-300 outline-offset-2 bg-emerald-300 text-base-500 ml-auto"
        >
          Close
        </button>
        <div class="slider-container flex items-center justify-center mt-3 md:mt-6 p-3 overflow-clip">
          <div class="slider outline-2 outline-offset-8 rounded-md relative overflow-clip max-w-[400px] h-[500px] w-full">
            <div class="slides flex overflow-x-scroll relative scroll-smooth snap-mandatory snap-x">
              {images.map((item, i) => (
                <div
                  id={`slides__${i + 1}`}
                  class="slide origin-center scale-100 flex items-center justify-center flex-shrink-0 w-full h-[500px] flex-shrink-0 mr-0 snap-center"
                >
                  <SliderImage
                    image={item.image}
                    altText={item.alt || ''}
                    width={item.image.width}
                    height={item.image.height}
                    caption={item.caption}
                  />
                  <a
                    class="slide__prev absolute left-2 absolute left-2"
                    href={`#slides__${i === 0 ? images.length : i}`}
                    title="Next"
                  >
                    <Icon
                      class="text-3xl text-base-500 p-0.5 outline outline-2 transition-colors duration-200 outline-transparent hover:outline-emerald-300/95 outline-offset-1 focus-visible:outline-emerald-300/95 bg-emerald-300/95 rounded-full"
                      name="arrows/left"
                    />
                  </a>
                  <a
                    class="slide__next absolute right-1 absolute right-1"
                    href={`#slides__${lastOf === i ? 1 : i + 2}`}
                    title="Next"
                  >
                    {images.length === i && 'True'}
                    <Icon
                      class="text-3xl text-base-500 p-0.5 outline outline-2 transition-colors duration-200 outline-transparent hover:outline-emerald-300/95 outline-offset-1 focus-visible:outline-emerald-300/95 text-base-500 bg-emerald-300/95 rounded-full"
                      name="arrows/right"
                    />
                  </a>
                </div>
              ))}
            </div>
            <div class="slider__nav">
              {images.map((item, i) => (
                <a class="slider__navlink" href={`#slides__${i + 1}`}>
                  <span class="sr-only">Go to slide {i + 1}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </dialog>
      <button class="px-2 cursor-pointer py-1 mt-6 flex focus-visible:outline-emerald-300 font-mono outline transition-colors duration-200 rounded-xs hover:outline-emerald-300 outline-offset-2 bg-emerald-300 text-base-500">
        View layouts
      </button>
    </div>
  )
}

