---
import { Icon } from 'astro-icon/components';
import SliderImage from '@components/media/SliderImage.astro';

interface Props {
  images?: { image: ImageMetadata; alt?: string; caption?: string }[];
}

const { images } = Astro.props;

const lastOf = images && images.length - 1;
---

{
  images && images.length > 0 && (
    <div>
      <dialog class="w-full m-auto bg-base-default/80 p-3 md:p-6 backdrop:bg-base-default md:backdrop:bg-base-default/80">
        <button
          autofocus
          class="px-2 cursor-pointer focus-visible:outline-highlight py-1 md:mt-6 flex font-mono outline transition-colors duration-200 rounded-xs hover:outline-highlight outline-offset-2 bg-highlight text-base-default ml-auto"
        >
          Close
        </button>
        <div class="slider-container flex items-center justify-center mt-3 md:mt-6 p-3 overflow-clip">
          <div class="slider outline-2 outline-offset-6 outline-border rounded-md relative overflow-clip max-w-[800px] h-[500px] w-full">
            <div class="slides flex overflow-x-scroll relative scroll-smooth snap-mandatory snap-x">
              {images.map((item, i) => (
                <div
                  id={`slides__${i + 1}`}
                  aria-label={`Slide ${i + 1} of ${images.length}`}
                  class="slide origin-center scale-100 flex items-center justify-center flex-shrink-0 w-full h-[500px] flex-shrink-0 mr-0 snap-center"
                >
                  <SliderImage
                    image={item.image}
                    altText={item.alt || ''}
                    width={item.image.width}
                    height={item.image.height}
                    caption={item.caption}
                    index={i}
                  />

                  <a
                    class="slide__prev absolute left-2"
                    href={`#slides__${i === 0 ? images.length : i}`}
                    title="Next"
                  >
                    <Icon
                      class="text-3xl text-base-default p-0.5 outline outline-2 transition-colors duration-200 outline-transparent hover:outline-highlight/95 outline-offset-1 focus-visible:outline-highlight/95 bg-highlight/95 rounded-full"
                      name="arrows/left"
                    />
                  </a>
                  <a
                    class="slide__next absolute right-2"
                    href={`#slides__${lastOf === i ? 1 : i + 2}`}
                    title="Next"
                  >
                    {images.length === i && 'True'}
                    <Icon
                      class="text-3xl text-base-default p-0.5 outline outline-2 transition-colors duration-200 outline-transparent hover:outline-highlight/95 outline-offset-1 focus-visible:outline-highlight/95 text-base-default bg-highlight/95 rounded-full"
                      name="arrows/right"
                    />
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      </dialog>
      <button class="px-2 cursor-pointer py-1 ml-auto mt-6 flex focus-visible:outline-highlight outline-transparent font-mono outline transition-colors duration-200 rounded-xs hover:outline-highlight outline-offset-2 bg-highlight text-base-default">
        View layouts
      </button>
    </div>
  )
}

<style>
  .slide a {
    background: none;
    border: none;
  }

  .slider::before,
  .slider::after {
    content: '';
    z-index: 1;
    background: none;
    pointer-events: none;
  }

  .slider__nav {
    box-sizing: border-box;
    position: absolute;
    bottom: 5%;
    left: 50%;
    width: 200px;
    margin-left: -100px;
    text-align: center;
  }

  .slider__navlink {
    display: inline-block;
    height: 15px;
    width: 15px;
    border-radius: 50%;
    /* background-color: black; */
    margin: 0 10px 0 10px;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    // This runs on first page load and after every navigation.

    const dialog = document.querySelector('dialog')!;
    const showButton = document.querySelector('dialog + button')!;
    const closeButton = document.querySelector('dialog button')!;

    // "Show the dialog" button opens the dialog modally
    showButton.addEventListener('click', () => {
      dialog.showModal();
    });

    // "Close" button closes the dialog
    closeButton.addEventListener('click', () => {
      dialog.close();
    });
  });
</script>
