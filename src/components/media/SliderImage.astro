---
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import { Picture } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  altText: string;
  caption?: string;
  height?: string | number;
  width?: string | number;
  index?: number;
}

const { index = 0, image, altText, caption, height, width } = Astro.props;
---

<figure class:list={['w-full h-full bg-base-muted p-4']}>
  <Picture
    src={image}
    quality={100}
    loading="eager"
    height={Number(height)}
    width={Number(width)}
    formats={['avif', 'webp']}
    class="object-contain h-full rounded-md"
    alt={altText}
  />
  {
    caption && (
      <figcaption
        class:list={[
          'absolute bottom-2 flex items-center gap-1 left-2 text-base-default text-sm bg-highlight font-mono pl-1 pr-2 py-0.5 ',
        ]}
      >
        <Icon name="arrows/right" aria-hidden="true" />
        {caption}
      </figcaption>
    )
  }

  <div
    aria-hidden="true"
    class="absolute hidden sm:flex bottom-2 right-0 left-0 flex justify-center gap-3 p-1"
  >
    <a
      class:list={[
        'flex h-3 w-3 rounded-full bg-slate-800',
        index + 1 === 1 && 'outline-1 outline-offset-2 outline-slate-800 ',
      ]}
      href={`#slides__${1}`}
    >
    </a>
    <a
      class:list={[
        'flex h-3 w-3 rounded-full bg-slate-800',
        index + 1 === 2 && 'outline-1 outline-offset-2 outline-slate-800 ',
      ]}
      href={`#slides__${2}`}
    >
    </a>
    <a
      class:list={[
        'flex h-3 w-3 rounded-full bg-slate-800',
        index + 1 === 3 && 'outline-1 outline-offset-2 outline-slate-800 ',
      ]}
      href={`#slides__${3}`}
    >
    </a>
  </div>
</figure>
