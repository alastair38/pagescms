---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  altText: string;
  caption?: string;
  height?: string | number;
  width?: string | number;
}

const { image, altText, caption, height, width } = Astro.props;
---

<figure class:list={['w-full h-[500px]']}>
  <Picture
    src={image}
    quality={100}
    loading="eager"
    height={Number(height)}
    width={Number(width)}
    formats={['avif', 'webp']}
    class="object-cover w-full h-full rounded-xs"
    alt={altText}
  />
  {
    caption && (
      <figcaption
        class:list={[
          'absolute bottom-16 right-4 left-4 bg-white/90 rounded-xs font-mono px-1 text-base-400',
        ]}
      >
        {caption}
      </figcaption>
    )
  }
</figure>
