---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'h1'> {
  title: string;
}

const { title = 'Remember to add a title', ...attr } = Astro.props;
---

<h1
  class:list={[
    'px-4 py-1 text-pretty text-3xl md:text-5xl lg:text-7xl leading-none text-write-300 font-light',
    attr.class,
  ]}
  {...attr}
>
  {title}
</h1>
