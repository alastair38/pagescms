---
// RelativeLink.astro for links based on content ID and collection type as returned by getEntries / getCollection
import { urlBuilderFromId } from '@utils/formatters';
import { Icon } from 'astro-icon/components';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  id: string;
  type: string;
  icon?: boolean;
  label?: string;
  variant?: 'default' | 'button' | 'outline' | 'striped' | 'animate';
  size?: 'small' | 'default';
}

const {
  id,
  type,
  icon,
  label,
  variant = 'default',
  size = 'default',
  ...attrs
} = Astro.props;

// {urlBuilderFromId(id, type, 'http://localhost:4321')}
---

<a
  class:list={[
    'font-mono rounded-xs group peer border-[0.05em] transition-colors duration-300 px-2 py-1 gap-1 items-center flex w-fit group',
    variant === 'default' &&
      'border-highlight hover:bg-highlight/90 bg-highlight  text-base-default ',
    variant === 'outline' &&
      'border-border text-write hover:border-write focus-visible:border-write',
    variant === 'striped' &&
      'border-border text-write hover:border-write focus-visible:border-write',
    size === 'small' && 'text-sm',
    attrs.class,
  ]}
  href={urlBuilderFromId(id, type)}
  {...attrs}
>
  {label ? label : 'Find out more'}
  {icon && <Icon class="translate-x-0.5" name="arrows/right-point" />}
</a>

{
  variant === 'striped' && (
    <div
      aria-hidden={true}
      class="striped-background transition-colors duration-300 peer-hover:text-highlight flex-1"
    />
  )
}
