---
import { Icon } from 'astro-icon/components';

interface Props {
  accent?: boolean;
  border?: 'top' | 'bottom' | 'both' | 'none';
}

const { accent = false, border = 'none' } = Astro.props as Props;
---

<div
  aria-hidden={true}
  class:list={[
    'text-base-muted px-4 py-4 md:py-6 flex border-border justify-between md:justify-start gap-6',
    border === 'top' && 'border-t-narrow',
    border === 'bottom' && 'border-b-narrow',
    border === 'both' && 'border-t-narrow border-b-narrow',
  ]}
>
  <Icon
    class:list={[
      'rotate-45 rounded-full h-12 w-12 md:h-24 md:w-24 p-2 text-base-default',
      accent ? 'bg-highlight-strong/60' : 'bg-write/10',
    ]}
    name="arrows/right-point"
    aria-hidden="true"
  />
  <Icon
    class:list={[
      'rotate-45 rounded-full h-12 w-12 md:h-24 md:w-24 p-2 text-base-default',
      accent ? 'bg-highlight-strong/80' : 'bg-write/20',
    ]}
    name="arrows/right-point"
    aria-hidden="true"
  />
  <Icon
    class:list={[
      'rotate-45 rounded-full h-12 w-12 md:h-24 md:w-24 p-2 text-base-default',
      accent ? 'bg-highlight-strong' : 'bg-write/30',
    ]}
    name="arrows/right-point"
    aria-hidden="true"
  />
</div>
