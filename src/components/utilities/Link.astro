---
import type { Link } from '@customTypes/utilities';
import { urlBuilder, urlBuilderFromId } from '@utils/formatters';
import { Icon } from 'astro-icon/components';
import type { HTMLAttributes } from 'astro/types';

// To avoid repetition this component has been extended to handle both relative and absolute links. If a link object is passed, it will use the link's properties to build the URL. If an id and type are passed, it will use those to build the URL.

interface Props extends HTMLAttributes<'a'> {
  link?: Link;
  id?: string;
  type?: string;
  icon?: boolean;
  label?: string;
  variant?: 'default' | 'button' | 'outline' | 'striped' | 'animate' | 'plain';
  size?: 'small' | 'default';
}

const {
  link,
  id,
  type,
  icon,
  label,
  variant = 'default',
  size = 'default',
  ...attrs
} = Astro.props;
---

<a
  class:list={[
    'font-mono group peer transition-colors duration-300 items-center flex w-fit',
    variant === 'default' &&
      'border-highlight hover:bg-highlight/90 bg-highlight  text-base-default ',
    variant === 'outline' &&
      'border-border text-write hover:border-write focus-visible:border-write',
    variant === 'striped' &&
      'border-border text-write hover:border-write-muted/40 focus-visible:border-write',
    variant === 'animate' && 'animate-highlight text-write',
    variant === 'plain' &&
      'text-write hover:text-highlight focus-visible:text-highlight',
    variant !== 'plain' && ' rounded-xs px-2 py-1 gap-1 w-fit border-narrow',
    size === 'small' && 'text-sm',
    attrs.class,
  ]}
  href={link
    ? urlBuilder(link.link, link.type)
    : id && type && urlBuilderFromId(id, type)}
  {...attrs}
>
  {link && link.label ? link.label : label || 'Find out more'}
  {
    icon && (
      <Icon
        class="translate-x-0.5"
        name="arrows/right-point"
        aria-hidden="true"
      />
    )
  }
</a>
{
  variant === 'striped' && (
    <div
      aria-hidden={true}
      class="striped-background transition-colors duration-300 peer-hover:text-write-muted/40 flex-1"
    />
  )
}
