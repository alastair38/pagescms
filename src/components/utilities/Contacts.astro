---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props {
  contact: CollectionEntry<'person'>['data']['contact'];
}

const { contact } = Astro.props;
---

{
  contact && (
    <ul
      aria-label="Contact links"
      class="flex items-center text-write text-xl gap-3"
    >
      {contact.email && (
        <li>
          <a
            class="group"
            href={`mailto:${contact.email.link}`}
            target="_blank"
          >
            <span class="sr-only">{contact.email.label}</span>
            <Icon
              class="text-2xl group-hover:scale-105 transition-transform duration-200"
              name="contact/email"
            />
          </a>
        </li>
      )}
      {contact.bluesky && (
        <li>
          <a class="group" href={`${contact.bluesky.link}`} target="_blank">
            <span class="sr-only">{contact.bluesky.label}</span>
            <Icon
              class="group-hover:scale-105 transition-transform duration-200"
              name="contact/bluesky"
            />
          </a>
        </li>
      )}
      {contact.linkedin && (
        <li>
          <a class="group" href={`${contact.linkedin.link}`} target="_blank">
            <span class="sr-only">{contact.linkedin.label}</span>
            <Icon
              class="group-hover:scale-105 transition-transform duration-200"
              name="contact/linkedin"
            />
          </a>
        </li>
      )}
      {contact.x && (
        <li>
          <a class="group" href={`${contact.x.link}`} target="_blank">
            <span class="sr-only">{contact.x.label}</span>
            <Icon
              class="group-hover:scale-105 transition-transform duration-200"
              name="contact/x"
            />
          </a>
        </li>
      )}
    </ul>
  )
}
