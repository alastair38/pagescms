---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  title: string;
  description?: string;
}

const { title, description, ...attr } = Astro.props;
---

<div
  class:list={[
    'col-span-full max-w-content flex flex-col py-2 px-6',
    attr.class,
  ]}
>
  <details class="group">
    <summary
      class="flex font-mono bg-base-400 w-fit pl-2 pr-3 py-1 rounded-full text-write-300 my-3 marker:hidden leading-normal cursor-pointer items-center gap-2 group"
    >
      <svg
        aria-hidden="true"
        class="-mr-1 h-5 w-5 fill-current opacity-75 transition-transform duration-300 group-open:fill-highlight-300 group-open:rotate-90"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
      >
        <path
          d="M12.95 10.707l.707-.707L8 4.343 6.586 5.757 10.828 10l-4.242 4.243L8 15.657l4.95-4.95z"
        ></path>
      </svg>{title}</summary
    >
    <div class="px-2 pb-2">
      {
        description && (
          <p class="text-write-300 mt-3 mb-4 flex divide-x font-mono text-sm">
            {description}
          </p>
        )
      }
      <ul class="flex gap-3 items-center">
        <li>
          <label
            class="flex cursor-pointer w-fit px-3 has-checked:outline-base-400 has-checked:bg-base-300 transition-colors duration-200 outline outline-offset-2 outline-transparent py-1 rounded-sm bg-base-400 text-write-300 col-span-full items-center"
          >
            Content
            <input
              data-type="content"
              class="sr-only"
              type="checkbox"
              value="test"
            />
          </label>
        </li>

        <li>
          <label
            class="flex cursor-pointer w-fit px-3 has-checked:outline-base-400 has-checked:bg-base-300 transition-colors duration-200 outline outline-offset-2 outline-transparent py-1 rounded-sm bg-base-400 text-write-300 col-span-full items-center"
          >
            Media
            <input
              data-type="media"
              class="sr-only"
              type="checkbox"
              value="test"
            />
          </label>
        </li>

        <li>
          <label
            class="flex cursor-pointer w-fit px-3 has-checked:outline-base-400 has-checked:bg-base-300 transition-colors duration-200 outline outline-offset-2 outline-transparent py-1 rounded-sm bg-base-400 text-write-300 col-span-full items-center"
          >
            Vendor free
            <input
              data-type="vendor"
              class="sr-only"
              type="checkbox"
              value="test"
            />
          </label>
        </li>
      </ul>
    </div>
  </details>
</div>
