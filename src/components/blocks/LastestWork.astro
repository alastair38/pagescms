---
import type { LatestContent } from '@customTypes/blocks';
import GridWrapper from '@components/layouts/GridWrapper.astro';
import GridItem from '@components/layouts/GridItem.astro';
import { getCollection } from 'astro:content';
import IconSpacer from '@components/utilities/IconSpacer.astro';
import BlockWrapper from '@components/layouts/BlockWrapper.astro';
import Heading2 from '@components/headings/Heading2.astro';
import BlockHeader from '@components/layouts/BlockHeader.astro';
import Description from '@components/layouts/Description.astro';

const {
  __typename,
  title,
  description,
  itemsToShow = 3,
} = Astro.props as LatestContent;

const items = await getCollection('work');

const contentItems = items.slice(0, itemsToShow);
---

<BlockWrapper data-block={__typename}>
  <IconSpacer border="bottom" />

  <GridWrapper data-component="grid" data-store={JSON.stringify(items)}>
    <BlockHeader>
      <Heading2 style="mono" size="small" class="mb-2">
        {title}
      </Heading2>

      {description && <Description>{description}</Description>}
    </BlockHeader>

    {
      contentItems && contentItems.length > 0
        ? contentItems.map(item => (
            <GridItem
              item={item}
              data-id={item.id}
              data-component="grid-item"
              data-visible="true"
              class="duration-200 transition-all"
              heading={title ? true : false}
            />
          ))
        : '<p>No content yet</p>'
    }
  </GridWrapper>
</BlockWrapper>
