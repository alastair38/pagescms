---
import type { RelatedContent } from '@customTypes/blocks';
import { urlBuilderFromId } from '@utils/formatters';
import { Icon } from 'astro-icon/components';
import { getEntries, type ReferenceDataEntry } from 'astro:content';
import Path from 'path';
import BlockWrapper from '@components/layouts/BlockWrapper.astro';
import Heading2 from '@components/headings/Heading2.astro';

const {
  __typename,
  title = 'You might also be interested in ...',
  links,
} = Astro.props as RelatedContent;

const result =
  links &&
  links.length > 0 &&
  links!.map(person => ({
    id: Path.parse(person.link).name,
    collection: person.type as 'work' | 'page',
  }));

const related = await getEntries(
  result as ReferenceDataEntry<'work' | 'page', string>[],
);
---

{
  related && related.length > 0 && (
    <BlockWrapper
      tag="aside"
      data-block={__typename}
      class="p-4 md:p-6 space-y-1 bg-base-muted font-mono"
    >
      <Heading2 size="small" class="mb-4 border-b border-b-base-default">
        {title}
      </Heading2>

      {related.map(item => (
        <a
          class="flex items-center group hover:text-write-strong duration-200 transition-colors gap-2"
          href={urlBuilderFromId(item.id, item.collection)}
        >
          {item.data.meta?.title && item.data.meta.title}
          <Icon
            class="bg-highlight text-base-default transition-transform duration-200 group-hover:translate-x-0.5 rounded-full text-xl p-0.5"
            name="arrows/right-point"
            aria-hidden="true"
          />
        </a>
      ))}
    </BlockWrapper>
  )
}
