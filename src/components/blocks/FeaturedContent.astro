---
import type { FeaturedContent } from '@customTypes/blocks';
import { Picture } from 'astro:assets';
import Link from '@components/utilities/Link.astro';
import Heading2 from '@components/headings/Heading2.astro';
import Heading3 from '@components/headings/Heading3.astro';
import Description from '@components/layouts/Description.astro';
import BlockWrapper from '@components/layouts/BlockWrapper.astro';
import BlockHeader from '@components/layouts/BlockHeader.astro';
import FeaturedImage from '@components/FeaturedImage.astro';
import { getContentId } from '@utils/formatters';

const { __typename, title, description, sections } =
  Astro.props as FeaturedContent;
---

<BlockWrapper data-block={__typename} class="text-base-muted grid mx-auto">
  <BlockHeader>
    <Heading2 style="mono" size="small" class="mb-2">
      {title}
    </Heading2>

    {description && <Description>{description}</Description>}
  </BlockHeader>

  {
    sections && sections.length > 0 && (
      <div class="divide-border divide-y-[0.05em]">
        {sections.map((section, i) => (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 p-3 md:p-6">
            {section.image && (
              <FeaturedImage
                transition:name={
                  section.links && getContentId(section.links[0].link)
                }
                image={section.image.src}
                altText={section.image.alt || ''}
                width={section.image.src.width}
                height={section.image.src.height}
                border={true}
                loading="lazy"
              />
              // <Picture
              //   transition:name="bert"
              //   src={section.image.src}
              //   quality={100}
              //   format="webp"
              //   loading="eager"
              //   style="object-fit: cover;"
              //   class:list={[
              //     'aspect-square w-full rounded-xs max-h[300px] opacity-75 duration-500 animate-slight-fade  md:max-h[500px] object-cover',
              //     i % 2 === 0 ? 'order-first' : 'order-last',
              //   ]}
              //   alt={section.image.alt || ''}
              // />
            )}

            <div
              class:list={[
                'flex flex-col md:px-8 text-write gap-4 justify-center',
                i % 2 === 0 ? 'md:order-last' : 'md:order-first',
              ]}
            >
              {title ? (
                <Heading3 size="large" weight="bold">
                  {section.title}
                </Heading3>
              ) : (
                <Heading2 size="large" weight="bold">
                  {section.title}
                </Heading2>
              )}

              {section.description && (
                <Description>{section.description}</Description>
              )}

              {section.links && section.links.length > 0 && (
                <div class="flex gap-3 mt-3">
                  {section.links.map(link => (
                    <Link link={link} icon={true} label="View details" />
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    )
  }
</BlockWrapper>
