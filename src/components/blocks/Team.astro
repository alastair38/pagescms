---
import type { Team } from '@customTypes/blocks';

import { getEntries, type ReferenceDataEntry } from 'astro:content';
import Path from 'path';
import BlockWrapper from '@components/layouts/BlockWrapper.astro';
import GridWrapper from '@components/layouts/GridWrapper.astro';
import PersonCard from '@components/layouts/PersonCard.astro';
import Description from '@components/layouts/Description.astro';
import BlockHeader from '@components/layouts/BlockHeader.astro';
import Heading2 from '@components/headings/Heading2.astro';

const {
  __typename,
  title = 'You might also be interested in ...',
  description,
  links,
} = Astro.props as Team;

const members =
  links &&
  links.length > 0 &&
  links!.map(person => ({
    id: Path.parse(person.link).name,
    collection: person.type as 'person',
  }));

const team = await getEntries(
  members as ReferenceDataEntry<'person', string>[],
);
---

{
  team && team.length > 0 && (
    <BlockWrapper tag="aside" data-block={__typename} class=" text-write">
      <GridWrapper outline={true} gridSize={team.length}>
        <BlockHeader>
          <Heading2 style="mono" size="small" class="mb-2">
            {title}
          </Heading2>

          {description && <Description>{description}</Description>}
        </BlockHeader>
        {team.map(item => (
          <PersonCard item={item} heading={title ? true : false} />
        ))}
      </GridWrapper>
    </BlockWrapper>
  )
}
