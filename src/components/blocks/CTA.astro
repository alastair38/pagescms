---
import Link from '@components/utilities/Link.astro';
import type { CTA } from '@customTypes/blocks';
import { Icon } from 'astro-icon/components';
import Heading2 from '@components/headings/Heading2.astro';
import Description from '@components/layouts/Description.astro';
import BlockWrapper from '@components/layouts/BlockWrapper.astro';

const { __typename, title, description, links } = Astro.props as CTA;
---

<BlockWrapper
  data-block={__typename}
  class="text-base-muted relative dotted-background px-8 py-16 md:py-32 md:px-20"
>
  <div
    class="w-fit relative opacity-50 animate-fade transition-opacity mx-auto flex"
  >
    <Icon
      class:list={[
        'mx-auto z-10 h-16 w-16 text-3xl  drop-shadow-highlight-muted/40 drop-shadow text-base-muted',
      ]}
      name="items/exclude-square"
      aria-hidden="true"
    />
    <div
      class="w-24 h-24 z-0 bg-highlight-muted/20 blur-2xl absolute -inset-4 rounded-full"
    >
    </div>
  </div>

  <div class="text-center text-write mt-3">
    <Heading2 size="xl" weight="light"> {title}</Heading2>
    {
      description && (
        <Description weight="light" class="mx-auto mt-4 mb-6 md:mt-8 md:mb-12">
          {description}
        </Description>
      )
    }
    {
      links && links.length > 0 && (
        <div class="flex justify-center gap-3">
          {links.map(link => (
            <Link link={link} icon={true} />
          ))}
        </div>
      )
    }
  </div>
</BlockWrapper>
