---
// this will let us render markdown from richText blocks (which is stored as a string)
import { Markdown } from 'astro-remote';
import BlockWrapper from '@components/layouts/BlockWrapper.astro';
interface Props {
  body: string;
  __typename: string;
}

const { body, __typename } = Astro.props;
---

<BlockWrapper
  data-block={__typename}
  class:list={[
    'prose max-w-none w-content prose-headings:mb-3 prose-headings:text-current prose-headings:font-bold prose-a:text-current prose-a:hover:decoration-highlight/40 prose-a:transition-colors prose-a:duration-200 prose-a:decoration-highlight prose-strong:text-current text-current',
  ]}
>
  <Markdown content={body} />
</BlockWrapper>
