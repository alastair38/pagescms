---
// this will let us render markdown from richText blocks (which is stored as a string)
import { Markdown } from 'astro-remote';
import BlockWrapper from '@components/layouts/BlockWrapper.astro';
interface Props {
  body: string;
  __typename: string;
}

const { body, __typename } = Astro.props;
---

<BlockWrapper
  data-block={__typename}
  class="prose prose-headings:mb-3 prose-headings:text-current prose-headings:font-normal prose-a:text-current max-w-none prose-a:hover:decoration-highlight-300/40 prose-a:transition-colors prose-a:duration-200 prose-a:decoration-highlight-300 prose-strong:text-current mx-auto text-current"
>
  <Markdown content={body} />
</BlockWrapper>
