---
import { datetimeFormat, dateFormat } from '@utils/formatters';
import type { HTMLAttributes } from 'astro/types';
import type { CollectionEntry } from 'astro:content';

interface Props extends HTMLAttributes<'aside'> {
  authors?: CollectionEntry<'person'>[];
  pubDate?: string | Date;
}

const { authors, pubDate, ...attr } = Astro.props;
---

<aside
  class:list={[
    'font-mono text-write-strong flex flex-col text-sm gap-2 max-h-fit w-full md:sticky top-6',
    attr.class,
  ]}
  {...attr}
>
  {
    pubDate && (
      <time datetime={datetimeFormat(pubDate)}>{dateFormat(pubDate)}</time>
    )
  }
  <slot />
</aside>
