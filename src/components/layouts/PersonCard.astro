---
import RelativeLink from '@components/utilities/RelativeLink.astro';
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Heading2 from '@components/headings/Heading2.astro';
import Heading3 from '@components/headings/Heading3.astro';
import Description from '@components/layouts/Description.astro';

interface Props {
  item: CollectionEntry<'person'>;
  heading?: boolean;
}

const { item, heading } = Astro.props;
---

<div class="bg-base-500 flex flex-col p-6 text-write-300 block-outline">
  {
    item.data.featuredImage && (
      <Picture
        transition:name={`${item.id}`}
        src={item.data.featuredImage.image}
        quality={100}
        format="webp"
        loading="eager"
        style="object-fit: cover;"
        class="aspect-square w-full rounded-xs max-h-[300px] md:max-h-[500px] object-cover"
        alt={item.data.featuredImage.alt || ''}
      />
    )
  }

  {
    heading ? (
      <Heading3 weight="bold" size="small" class="mt-4">
        {item.data.name}
      </Heading3>
    ) : (
      <Heading2 weight="bold" size="small" class="mt-4">
        {item.data.name}
      </Heading2>
    )
  }
  {
    item.data.jobTitle && (
      <Description size="small" class="mb-4">
        {item.data.jobTitle}
      </Description>
    )
  }

  <div class="flex font-mono gap-3 mt-2">
    <RelativeLink
      id={item.id}
      type={item.collection}
      label="View profile"
      variant="outline"
      icon={true}
      size="small"
    />

    <div aria-hidden="true" class="striped-background flex-1 text-base-400">
    </div>
  </div>
</div>
