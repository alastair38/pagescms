---
import type { Details } from '@customTypes/utilities';
import type { HTMLAttributes } from 'astro/types';
import type { CollectionEntry } from 'astro:content';

interface Props extends HTMLAttributes<'div'> {
  details?: Details;
  title: string;
}

const { details, title, ...attr } = Astro.props;
---

<div
  class:list={[
    'flex gap-2 text-base-default items-center font-mono text-sm',
    attr.class,
  ]}
  {...attr}
>
  <span class="sr-only">{title}</span>

  <ul class="flex items-center gap-2">
    {
      details && details.framework && (
        <li class="px-2 py rounded-full bg-highlight">{details.framework}</li>
      )
    }

    {
      details && details.cms && (
        <li class="px-2 py rounded-full bg-highlight">{details.cms}</li>
      )
    }

    {
      details && details.database && (
        <li class="px-2 py rounded-full bg-highlight">{details.database}</li>
      )
    }
  </ul>

  {
    details && details.versions && (
      <div class="flex items-center justify-center text-write">
        <span class="flex items-center justify-center w-6 h-6 p-1 rounded-full bg-base-muted">
          {details.versions}
        </span>
        <span class="sr-only">versions</span>
      </div>
    )
  }
</div>
