---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  fullPage?: boolean;
}

const { fullPage = false, ...attr } = Astro.props as Props;
---

<div
class:list={['text-base-400 flex flex-col-reverse md:flex-row gap-8 md:gap-16 border-t-narrow', !fullPage ? 'px-4 py-6' : 'p-0']}
  {...attr}
>
{!fullPage ? 
  <div class="text-write-300 max-w-content space-y-6">
    <slot name="content" />
  </div>
  <slot name="aside" /> : <div class="text-write-300">
    <slot name="content" />
  </div> }

</div>
