---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  fullPage?: boolean;
}

const { fullPage = false, ...attr } = Astro.props as Props;
---

<div
class:list={['border-borderborder-t-narrow gap-8 md:gap-16', !fullPage ? 'px-4 py-6 flex flex-col-reverse md:flex-row' : '']}
  {...attr}
>
{!fullPage ? 
  <div class:list={['text-write max-w-content space-y-6']} slot="content">
    <slot name="content" />
  </div>
  <slot name="aside" /> : <div class="text-write ">
    <slot name="content" />
  </div> }

</div>
