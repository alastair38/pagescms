---
import type { CollectionEntry } from 'astro:content';
import Description from './Description.astro';
import Heading2 from '@components/headings/Heading2.astro';
import Heading3 from '@components/headings/Heading3.astro';
import FeaturedImage from '@components/FeaturedImage.astro';
import ContentDetails from './ContentDetails.astro';
import type { HTMLAttributes } from 'astro/types';
import Link from '@components/utilities/Link.astro';

interface Props extends HTMLAttributes<'div'> {
  item:
    | CollectionEntry<'work'>
    | CollectionEntry<'template'>
    | CollectionEntry<'article'>;
  heading?: boolean;
  singleItem?: boolean;
}

const { item, heading, singleItem = false, ...attr } = Astro.props;
---

<div
  class:list={[
    'bg-base-default flex flex-col p-3 md:p-6 text-write outline outline-[0.05em] outline-border',
  ]}
  data-cms={item.collection !== 'article' &&
    item.data.meta?.details &&
    item.data.meta?.details.cms}
  data-framework={item.collection !== 'article' &&
    item.data.meta?.details &&
    item.data.meta?.details.framework}
  data-media={item.collection !== 'article' &&
    item.data.meta?.details &&
    item.data.meta?.details.mediaHandling}
  data-content={item.collection !== 'article' &&
    item.data.meta?.details &&
    item.data.meta?.details.contentUpdates}
  data-vendor={item.collection !== 'article' &&
    item.data.meta?.details &&
    item.data.meta?.details.vendorFree}
  {...attr}
>
  {
    item.data.meta?.featuredImage && (
      <FeaturedImage
        transition:name={`${item.id}`}
        image={item.data.meta.featuredImage.image}
        altText={item.data.meta.featuredImage?.alt || ''}
        width={item.data.meta.featuredImage.image.width}
        height={item.data.meta.featuredImage.image.height}
        loading="eager"
      />
    )
  }

  {
    heading ? (
      <Heading3 weight="bold" size="large" class="mt-4">
        {item.data.meta?.title}
      </Heading3>
    ) : (
      <Heading2 weight="bold" class="mt-4">
        {item.data.meta?.title}
      </Heading2>
    )
  }

  {
    item.data.meta?.description && (
      <Description size="small" class="mt-2 mb-4">
        {item.data.meta?.description}
      </Description>
    )
  }

  {
    item.collection !== 'article' && item.data.meta?.details && (
      <ContentDetails
        class="mb-6"
        details={item.data.meta?.details}
        title="Tech stack and versions"
      />
    )
  }

  <div class="flex font-mono gap-3 mt-auto">
    <Link
      id={item.id}
      type={item.collection}
      label="Find out more"
      variant="striped"
      icon={true}
      size="small"
    />
  </div>
</div>
