---
import type { HTMLAttributes, HTMLTag } from 'astro/types';

interface Props extends HTMLAttributes<'div' | 'article'> {
  tag?: HTMLTag;
}

const { tag: Element = 'div', ...attr } = Astro.props as Props;
---

<Element
  class="max-w-7xl z-10 bg-base-default border-border border-x-narrow mx-auto"
  {...attr}
>
  <slot />
</Element>
