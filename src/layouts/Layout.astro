---
import { getEntry } from 'astro:content';
import '../styles/global.css';

import Head from '@components/layouts/Head.astro';
import SiteHeader from '@components/layouts/SiteHeader.astro';
import type { HTMLAttributes } from 'astro/types';
import type { SeoType } from '@customTypes/utilities';

interface Props extends HTMLAttributes<'html'> {
  seo: SeoType;
}

const { seo, ...attr } = Astro.props as Props;

// fetch site settings for SEO and SiteHeader data
const settings = await getEntry('settings', 'main')!;
---

<html
  data-theme={settings.data.site.theme}
  data-duotone={settings.data.site.duotone}
  class="scroll-smooth"
  lang="en"
  {...attr}
>
  <Head seo={seo} settings={settings} />

  <body class="bg-base-default text-write">
    <SiteHeader settings={settings} />
    <main class="striped-background border-y-narrow border-border">
      <slot />
    </main>
    <footer
      class="font-mono text-sm gap-2 px-6 py-12 flex flex-col items-center justify-center"
    >
      <span>2025</span>
      <span>a northwalk website</span>
    </footer>
  </body>
</html>
