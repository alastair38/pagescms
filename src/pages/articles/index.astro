---
import { getCollection, getEntry } from 'astro:content';
import Layout from '@layouts/Layout.astro';

import ArticleWrapper from '@components/layouts/ArticleWrapper.astro';

import PageHeader from '@components/layouts/PageHeader.astro';
import GridWrapper from '@components/layouts/GridWrapper.astro';

import GridItem from '@components/layouts/GridItem.astro';

const workItems = await getCollection('article');
const articlePage = await getEntry('archive', 'article');

const seo = {
  title: articlePage?.data.title,
  description: articlePage?.data.description,
  image: articlePage?.data.featuredImage?.image,
};

console.log(workItems);
---

<Layout seo={seo}>
  <ArticleWrapper>
    <PageHeader
      title={articlePage?.data.title || 'Our Work'}
      byline={'articles'}
      description={articlePage?.data.body}
      archive={true}
    />

    <GridWrapper>
      {
        workItems.length > 0
          ? workItems.map(item => <GridItem item={item} />)
          : '<p>No content yet</p>'
      }
    </GridWrapper>
  </ArticleWrapper>
</Layout>
