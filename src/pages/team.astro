---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const settings = await getEntry('settings', 'index');
---

<Layout>
  <div class="max-w-7xl bg-base-500 border-x-[0.05em] mx-auto">
    <div class="text-base-900">
      <div class="px-4 py-1 flex items-end min-h-20 border-b-[0.05em]">
        <p class="font-mono text-write-400">Article</p>
      </div>
      <h1
        class="px-4 py-1 text-pretty text-8xl leading-none text-write-300 font-light"
      >
        Building modern websites for a better world.
      </h1>
    </div>
    <div class="px-4 py-1 flex items-end min-h-10 border-t-[0.05em]"></div>

    <div
      class="bg-base-400 border-t-[0.05em] grid grid-cols-3 grid-flow-row gap-[0.05em] max-w-7xl mx-auto"
    >
      <div
        class="bg-base-500 col-span-full font-mono flex px-6 pt-12 pb-2 text-write-300 items-center"
      >
        What we do
      </div>

      <div class="bg-base-500 flex flex-col p-6 text-write-300">
        <h2 class="text-2xl font-black">Websites</h2>

        <p class="mt-3 mb-6">
          Lorem ipsum dolor sit amet consectetur adipisicing elit. Cumque ut
          repellat consectetur blanditiis non reprehenderit culpa dignissimos
          nemo suscipit dolores quae delectus est, doloribus saepe quos quaerat
          quisquam distinctio ex.
        </p>
        <div class="flex font-mono gap-3">
          <a
            class="text-sm bg-write-300 text-base-500 flex wfit px-3 py-1"
            href="/">Find out more</a
          >
          <div class="striped-background flex-1 text-base-400"></div>
        </div>
      </div>
      <div
        class="bg-base-500 flex p-6 text-write-300 items-center justify-center"
      >
        Lorem ipsum dolor sit, amet consectetur adipisicing elit. Dicta
        aspernatur sunt accusamus culpa laudantium sapiente exercitationem
        veritatis at? Libero reiciendis nulla eius nisi nemo dolor mollitia
        dolorum architecto non animi.
      </div>
      <div
        class="bg-base-500 flex p-6 text-write-300 items-center justify-center"
      >
        Lorem ipsum dolor sit amet consectetur adipisicing elit. Illo enim
        architecto labore officiis harum! Assumenda porro laborum magnam, vero
        placeat laboriosam facere voluptatem nam iste deleniti in eaque, numquam
        architecto.
      </div>
    </div>
  </div>
</Layout>
