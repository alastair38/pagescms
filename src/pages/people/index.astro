---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';

import ArticleWrapper from '@components/layouts/ArticleWrapper.astro';

import PageHeader from '@components/layouts/PageHeader.astro';
import GridWrapper from '@components/layouts/GridWrapper.astro';

import GridItem from '@components/layouts/GridItem.astro';
import { getEntry } from 'astro:content';

const workItems = await getCollection('work');

const workPage = await getEntry('archive', 'work');

const seo = {
  title: workPage?.data.title,
  description: workPage?.data.description,
  image: workPage?.data.featuredImage?.image,
};
---

<Layout seo={seo}>
  <ArticleWrapper>
    <PageHeader
      title={workPage?.data.title || 'Our Work'}
      byline={'Work'}
      description={workPage?.data.body}
      archive={true}
    />

    <GridWrapper>
      {
        workItems.length > 0
          ? workItems.map(item => <GridItem item={item} />)
          : '<p>No content yet</p>'
      }
    </GridWrapper>
  </ArticleWrapper>
</Layout>
