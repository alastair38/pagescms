---
import FeaturedImage from '@components/FeaturedImage.astro';
import ArticleAside from '@components/layouts/ArticleAside.astro';
import ArticleWrapper from '@components/layouts/ArticleWrapper.astro';
import ContentWrapper from '@components/layouts/ContentWrapper.astro';
import PageHeader from '@components/layouts/PageHeader.astro';
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import GridItem from '@components/layouts/GridItem.astro';
import GridWrapper from '@components/layouts/GridWrapper.astro';
import Contacts from '@components/utilities/Contacts.astro';
import RichText from '@components/blocks/RichText.astro';
// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const posts = await getCollection('person');
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}
// 2. For your template, you can get the entry directly from the prop
const { post } = Astro.props;

const articles = await getCollection('article', ({ data }) => {
  return data.meta?.authors?.some(
    author => author.collection === 'person' && author.id === post.id,
  );
});

const seo = {
  title: post?.data.name,
  description: post?.data.bio,
  image: post?.data.featuredImage?.image,
};
---

<Layout seo={seo}>
  <ArticleWrapper>
    <PageHeader title={post.data.name} byline={'Team'} archive={true} />

    <ContentWrapper>
      <div class="max-w-content w-content space-y-4" slot="content">
        <Contacts contact={post.data.contact} />
        {
          post.data.bio && (
            <RichText __typename="richText" body={post.data.bio} />
          )
        }
      </div>

      <ArticleAside slot="aside">
        {
          post.data.featuredImage && (
            <FeaturedImage
              transition:name={`${post.id}`}
              image={post.data.featuredImage.image}
              altText={post.data.featuredImage?.alt || ''}
              width={post.data.featuredImage.image.width}
              height={post.data.featuredImage.image.height}
              caption={post.data.featuredImage.caption}
            />
          )
        }
      </ArticleAside>
    </ContentWrapper>

    {
      articles && articles.length > 0 && (
        <GridWrapper heading="Articles">
          {articles.map(item => (
            <GridItem item={item} heading={true} />
          ))}
        </GridWrapper>
      )
    }
  </ArticleWrapper>
</Layout>
