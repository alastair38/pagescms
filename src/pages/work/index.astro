---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';

import ArticleWrapper from '@components/layouts/ArticleWrapper.astro';

import PageHeader from '@components/layouts/PageHeader.astro';
import GridWrapper from '@components/layouts/GridWrapper.astro';

import GridItem from '@components/layouts/GridItem.astro';
import { getEntry } from 'astro:content';
import Filter from '@components/utilities/Filter.astro';

const workItems = await getCollection('work');

const workPage = await getEntry('archive', 'work');

const seo = {
  title: workPage?.data.title,
  description: workPage?.data.description,
  image: workPage?.data.featuredImage?.image,
};
---

<Layout seo={seo}>
  <ArticleWrapper>
    <PageHeader
      title={workPage?.data.title || 'Our Work'}
      byline={'Work'}
      archive={true}
    />

    <GridWrapper>
      <Filter
        title="Filter"
        description="Our templates can be grouped by specific features, such as an optimised editing experience, advanced media capabilites and those that prioritise no vendor lock-ins."
      />

      {
        workItems.length > 0
          ? workItems.map(item => <GridItem item={item} />)
          : '<p>No content yet</p>'
      }
    </GridWrapper>
  </ArticleWrapper>
</Layout>
