---
import FeaturedImage from '@components/FeaturedImage.astro';
import ArticleWrapper from '@components/layouts/ArticleWrapper.astro';
import ContentWrapper from '@components/layouts/ContentWrapper.astro';
import PageHeader from '@components/layouts/PageHeader.astro';
import Layout from '@layouts/Layout.astro';
import Slider from '@components/Slider.astro';

import { getCollection, render } from 'astro:content';
import ArticleAside from '@components/layouts/ArticleAside.astro';
// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const posts = await getCollection('work');
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}
// 2. For your template, you can get the entry directly from the prop
const { post } = Astro.props;

// const authorsArr: ReferenceDataEntry<'authors'>[] | undefined =
//   post.data.meta.authors?.map(author => {
//     return {
//       collection: 'authors',
//       id: author.id.substring(author.id.lastIndexOf('/') + 1).split('.')[0],
//     };
//   });

// const authors = (await getEntries(authorsArr!)) as CollectionEntry<'authors'>[];
const { Content } = await render(post);

const seo = {
  title: post?.data.meta?.title,
  description: post?.data.meta?.description,
  image: post?.data.meta?.featuredImage?.image,
};

console.log(post.id);
---

<Layout seo={seo}>
  <ArticleWrapper>
    <PageHeader
      title={post.data.meta?.title || ''}
      byline={post.collection}
      details={post.data.meta?.details}
    />

    <ContentWrapper>
      <Content slot="content" />

      <ArticleAside slot="aside">
        {
          post.data.meta?.featuredImage && (
            <FeaturedImage
              transition:name={`${post.id}`}
              image={post.data.meta?.featuredImage.image}
              altText={post.data.meta?.featuredImage?.alt || ''}
              width={post.data.meta?.featuredImage.image.width}
              height={post.data.meta?.featuredImage.image.height}
              caption={post.data.meta?.featuredImage.caption}
              loading="eager"
              border={true}
            />
          )
        }

        {post.data.slider && <Slider images={post.data.slider} />}
      </ArticleAside>
    </ContentWrapper>
  </ArticleWrapper>
</Layout>
