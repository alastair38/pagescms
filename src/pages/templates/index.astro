---
import { getCollection, getEntry } from 'astro:content';
import Layout from '@layouts/Layout.astro';

import ArticleWrapper from '@components/layouts/ArticleWrapper.astro';

import PageHeader from '@components/layouts/PageHeader.astro';
import GridWrapper from '@components/layouts/GridWrapper.astro';

import GridItem from '@components/layouts/GridItem.astro';

const workItems = await getCollection('template');
const templatePage = await getEntry('archive', 'template');

const seo = {
  title: templatePage?.data.title,
  description: templatePage?.data.description,
  image: templatePage?.data.featuredImage?.image,
};
---

<Layout seo={seo}>
  <ArticleWrapper>
    <PageHeader
      title={templatePage?.data.title || 'Our Work'}
      byline={'Templates'}
      description={templatePage?.data.body}
      archive={true}
    />

    <GridWrapper>
      {
        workItems.length > 0
          ? workItems.map(item => <GridItem item={item} />)
          : '<p>No content yet</p>'
      }
    </GridWrapper>
  </ArticleWrapper>
</Layout>
