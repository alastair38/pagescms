---
import FeaturedImage from '@components/FeaturedImage.astro';
import ArticleAside from '@components/layouts/ArticleAside.astro';
import ArticleWrapper from '@components/layouts/ArticleWrapper.astro';
import ContentWrapper from '@components/layouts/ContentWrapper.astro';
import PageHeader from '@components/layouts/PageHeader.astro';
import Layout from '@layouts/Layout.astro';
import Path from 'path';
import {
  getCollection,
  getEntries,
  render,
  type ReferenceDataEntry,
} from 'astro:content';
import BlockRenderer from '@components/BlockRenderer.astro';
// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const posts = await getCollection('page');
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}
// 2. For your template, you can get the entry directly from the prop
const { post } = Astro.props;

const test = [
  {
    type: 'work',
    label: 'A link',
    link: 'src/data/work/northwalk-1.md',
  },
  {
    type: 'page',
    label: 'A link',
    link: 'src/data/pages/about.md',
  },
];

const result: ReferenceDataEntry<'work' | 'page' | 'person', string>[] =
  test.map(person => ({
    id: Path.parse(person.link).name,
    collection: person.type as 'work' | 'page' | 'person',
  }));

// const morePages =
//   post.data.relatedPages && (await getEntries(post.data.relatedPages));

const relatedPages = result.length > 0 && (await getEntries(result));

function createRefObj(values: any[]) {
  values.map(
    (value: any) => {
      return {
        id: Path.parse(value.link).name,
        collection: value.type,
      };
    },
    //value.link.split('/').pop()?.split('.')
  );

  // console.log(refObj);

  //return refObj;
  //const afterLastSlash = value.split('/').pop()?.split('.')!;
}

const { Content } = await render(post);
const seo = {
  title: post?.data.meta?.title,
  description: post?.data.meta?.description,
  image: post?.data.meta?.featuredImage?.image,
};
---

<Layout {seo}>
  <ArticleWrapper tag="article">
    <PageHeader
      title={post.data.meta?.title || ''}
      byline={post.data.meta?.subHeading
        ? post.data.meta?.subHeading
        : post.collection}
      archive
    />

    <ContentWrapper fullPage={post.data.meta?.fullPage}>
      {
        post.data.contentBlocks && post.data.contentBlocks.length > 0 ? (
          <BlockRenderer slot="content" data={post.data.contentBlocks} />
        ) : (
          <p class="w-[85ch]" slot="content">
            Remember to add content to the page.
          </p>
        )
      }

      {
        !post.data.meta?.fullPage && (
          <ArticleAside class="space-y-6" slot="aside">
            {post.data.meta?.featuredImage && (
              <FeaturedImage
                transition:name={`${post.id}`}
                image={post.data.meta.featuredImage.image}
                altText={post.data.meta.featuredImage?.alt || ''}
                width={post.data.meta.featuredImage.image.width}
                height={post.data.meta.featuredImage.image.height}
                caption={post.data.meta.featuredImage.caption}
                border={true}
              />
            )}
          </ArticleAside>
        )
      }
    </ContentWrapper>
  </ArticleWrapper>
</Layout>
